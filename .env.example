# Copy this file to .env.local in the project root.
# Get both values from your Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# CLI authentication is configured separately with `npx supabase login`
# and `npx supabase link --project-ref YOUR_PROJECT_REF`.
# Do not put a database password or secret/service-role key in NEXT_PUBLIC_ variables.
